#
# Grizzy sensor device configuration registry script for the DVT stage.
#
# Source of truth: go/pixel-sensor-list
#

#
# CDT Filter <CDT>:<mask>
# CDT format: <0xPPPPSJIV> (P:Product, S:Stage, J:Major, I:Minor, V:Variant)
# go/pixel-cdt-mbu
#

?+0x50000:0xFFFF0000
# Exclude
?-0x52000:0xFFFFF000  # Proto
?-0x53000:0xFFFFF000  # EVT

#
# Record reg_script.
#

+/
reg_script=grizzly_dvt.reg

#
# Sensors
#

# Color Lights Driver
+/dev/b1010/0
  # Dimming control mode.
  # 0: Current data is preceded by a "dimming pulse".
  # 1: Current data is followed by a special control byte (0xB5).
  dimming_control_mode=1
  # Golden calibration values.
  xyz_to_pwm_0=1 0.473300 -0.122571 -0.063354 -0.091279 0.207750 -0.008159 0.002428 -0.005937 0.081304
  xyz_to_pwm_1=3 0.104150 -0.025557 -0.014287 -0.026248 0.059842 -0.002024 0.000873 -0.002111 0.024513

# ALSP
+/dev/tmd3743/0/als
  x_scale=0.9075
  lux_scale=0.9253
  z_scale=1.0226
  vsync_delay_us=307 307
  vsync_delay_2_us=911
  # DBV table and dependent parameters for each frequency in pwm_hz table.
  #   Each parameter is appended with an index, equal to the index of the
  #   PWM frequency it corresponds to, in the pwm_hz table.
  itime_table_brightness_0=1500 2918 16384
  itime_table_0=1600000 1200000 300000
  max_gain_table_0=7 7 7
  itime_table_brightness_1=1500 2918 16384
  itime_table_1=1600000 900000 300000
  max_gain_table_1=7 7 7

  prox_delay_1hz_0=21000 21000 21000
  prox_delay_10hz_0=21000 21000 21000
  prox_delay_30hz_0=21000 21000 21000
  prox_delay_60hz_0=21000 21000 21000
  prox_delay_120hz_0=21000 21000 21000
  prox_delay_1hz_1=21000 21000 21000
  prox_delay_10hz_1=21000 21000 21000
  prox_delay_30hz_1=21000 21000 21000
  prox_delay_60hz_1=21000 21000 21000
  prox_delay_120hz_1=21000 21000 21000

  # Golden value for fac-cal leakages.
  crgbw_leakage_at_dbv=240 106.0 66.0 40.0 12.0 118.0 2918 240 68.0 46.0 25.0 10.0 76.0 12908 480 326.0 199.0 116.0  51.0 339.0 2918 480 79.0 54.0 29.0 12.0 90.0 12908

+/dev/tmd3743/0/prox
  temp_coeff=0
  pdata_scale=3.896
  pdata_baseline=7228

# MAG (MMC5616WA)
+/dev/mmc5616/0/mag
  name=MMC5616 Magnetometer

+/dev/vd628x/0/spectral
  # Golden values for calibration.
  golden_rals_r=674.783984375
  golden_rals_g=1065.67929688
  golden_rals_b=548.128515625
  golden_rals_clr=4487.34375
  golden_rals_ir=1877.54570313
  golden_rals_visible=2231.21445313

+/dev/vd628x/0/rls
  lux_scale=115.691091
