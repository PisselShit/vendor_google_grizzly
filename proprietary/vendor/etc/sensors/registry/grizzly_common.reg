  histo_dbv_eq_480_0_0=345 1000 0 0
  histo_dbv_eq_480_0_1=1001 2918 0 -5.247566456511902 0.01904406536395062 -2.5588098458121664e-05 1.6430671707528948e-08 -5.086601158193036e-12 6.102252644879736e-16
